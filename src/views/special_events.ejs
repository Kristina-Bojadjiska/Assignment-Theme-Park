<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Special Events</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="events-page">
    <header>
        <h1>Upcoming Special Events</h1>
    </header>

    <nav>
        <a href="/">Home</a>
        <a href="/areas">Areas</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
        <a href="/special-events">Events</a>
    </nav>

    <main>
        <section class="events-container">
            <h2>Check Out Our Exciting Events</h2>
            <div class="events-list event-image-container">

                <!-- Event 1 - Jungle Party -->
                <div class="event-box">
                    <img src="/images/events/jungle_party_event.jpeg" alt="Party in the Jungle" class="event-image">
                    <div class="event-details">
                        <h3>Party in the Jungle</h3>
                        <p><strong>Start Date:</strong> 2024-05-12</p>
                        <p><strong>End Date:</strong> 2024-05-12</p>
                        <a href="/events/jungle-party">Learn More</a>
                    </div>
                </div>

                <!-- Event 2 - Adventure Week in Space -->
                <div class="event-box">
                    <img src="/images/events/adventure_week_in_space_event.jpeg" alt="Adventure Week in Space" class="event-image">
                    <div class="event-details">
                        <h3>Adventure Week in Space</h3>
                        <p><strong>Start Date:</strong> 2024-01-08</p>
                        <p><strong>End Date:</strong> 2024-01-15</p>
                        <a href="/events/adventure-week-in-space">Learn More</a>
                    </div>
                </div>

                <!-- Event 3 - Hunt for Pirate Treasure -->
                <div class="event-box">
                    <img src="/images/events/event_hunt.jpeg" alt="Hunt for Pirate Treasure" class="event-image">
                    <div class="event-details">
                        <h3>Hunt for Pirate Treasure</h3>
                        <p><strong>Start Date:</strong> 2024-11-06</p>
                        <p><strong>End Date:</strong> 2024-11-07</p>
                        <a href="/events/hunt-for-pirate-treasure">Learn More</a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <footer class="footer-container">
        <div>
            <p>&copy; 2024 Theme Park. All Rights Reserved.</p>
        </div>
    </footer>
</body>

</html>
